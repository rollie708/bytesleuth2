generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyses AnalysisJob[]

  @@map("users")
}

model AnalysisJob {
  id              String   @id @default(cuid())
  userId          String?
  chainId         Int
  contractAddress String
  blockNumber     Int?
  status          String   @default("PENDING")
  progressStage   String?
  errorCode       String?
  errorMessage    String?
  analysisVersion String   @default("1.0.0")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user      User?                @relation(fields: [userId], references: [id])
  snapshot  ContractSnapshot?
  artifacts AnalysisArtifact[]
  findings  Finding[]

  @@index([userId])
  @@index([contractAddress])
  @@index([status])
  @@index([createdAt])
  @@map("analysis_jobs")
}

model ContractSnapshot {
  id               String   @id @default(cuid())
  analysisJobId    String   @unique
  chainId          Int
  address          String
  blockNumber      Int
  bytecodeHash     String
  runtimeBytecode  String
  creationBytecode String?
  proxyMetadata    Json?
  createdAt        DateTime @default(now())

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@index([address, chainId])
  @@index([bytecodeHash])
  @@map("contract_snapshots")
}

model AnalysisArtifact {
  id            String   @id @default(cuid())
  analysisJobId String
  artifactType  String
  content       String
  contentHash   String?
  toolName      String
  toolVersion   String
  createdAt     DateTime @default(now())

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@index([analysisJobId])
  @@index([artifactType])
  @@map("analysis_artifacts")
}

model Finding {
  id            String   @id @default(cuid())
  analysisJobId String
  category      String
  title         String
  description   String
  severity      String
  confidence    String
  evidenceIds   String[]
  limitations   String?
  createdAt     DateTime @default(now())

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@index([analysisJobId])
  @@index([severity])
  @@map("findings")
}

model TransactionAnalysis {
  id          String   @id @default(cuid())
  chainId     Int
  txHash      String   @unique
  fromAddress String
  toAddress   String?
  value       String
  gasUsed     String?
  status      String?
  blockNumber Int?
  timestamp   DateTime?
  analysis    Json?
  createdAt   DateTime @default(now())

  @@index([txHash])
  @@index([fromAddress])
  @@index([toAddress])
  @@map("transaction_analyses")
}
